# Cognito PKCE sign-in (shared user pool from core infra; see core/infra/aws MainStack)
PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/<pool-id>
PUBLIC_COGNITO_CLIENT_ID=<app-client-id>

# Gateway base URL for browser calls (try-it console, credentials, session).
# Unset: dev falls back to http://localhost:4000, production builds to /api/gateway.
PUBLIC_GATEWAY_URL=http://localhost:4000
