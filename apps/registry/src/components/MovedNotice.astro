---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Chat native surface to open (`?native=`). */
  native: "credentials" | "admin";
  /** Optional provider id forwarded to chat. */
  provider?: string;
}

const { title, description, native, provider } = Astro.props;

const params = new URLSearchParams({ native });
if (provider) params.set("provider", provider);
const productAppUrl = `https://aprovan.com/chat/?${params.toString()}`;

const ctaLabel =
  native === "credentials" ? "Open credentials in app" : "Open admin in app";
---

<BaseLayout description={description} title={title}>
  <main class="mx-auto flex min-h-[50vh] w-full max-w-2xl flex-col items-center justify-center gap-4 px-4 py-16 text-center sm:px-6">
    <h1 class="text-2xl font-semibold tracking-tight">This page moved</h1>
    <p class="text-muted-foreground leading-7">{description}</p>
    <a
      class="inline-flex h-9 items-center justify-center rounded-lg border border-input bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-muted"
      href={productAppUrl}
    >
      {ctaLabel}
    </a>
  </main>
</BaseLayout>
