---
import { WorkflowsHost } from "@/components/WorkflowsHost";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  description="Register and operate workspace workflows: scripts that run on demand, on a cron schedule, on webhooks, or when events fire — with a full trace of every run."
  title="Workflows — Aprovan Registry"
>
  <main class="flex flex-col w-full min-h-screen gap-6 px-4 py-8 mx-auto max-w-5xl sm:px-6 lg:px-8">
    <section class="flex flex-col gap-3">
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Workflows
      </h1>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground">
        A workflow is a workspace script plus its triggers — manual, cron,
        webhook, or events. Scripts are plain async JavaScript with your
        connected tool namespaces as globals; every run records logs and one
        span per tool call. Register from here, the playground, or straight
        from chat with
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">workflows.register</code>.
      </p>
    </section>

    <WorkflowsHost client:only="react" />
  </main>
</BaseLayout>
