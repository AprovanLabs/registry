---
import { isLocalAccountHost } from "@/lib/account-host";
import { CredentialsHost } from "@/components/account/CredentialsHost";
import MovedNotice from "@/components/MovedNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const provider = Astro.url.searchParams.get("provider") ?? undefined;
const local = isLocalAccountHost();
---

{
  local ? (
    <BaseLayout
      description="Register and revoke API keys and OAuth tokens for UTDK providers."
      title="Account — Credentials"
    >
      <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <CredentialsHost client:only="react" initialProvider={provider} />
      </main>
    </BaseLayout>
  ) : (
    <MovedNotice
      description="Credential management has moved to the Aprovan product app."
      native="credentials"
      provider={provider}
      title="Account — moved"
    />
  )
}
