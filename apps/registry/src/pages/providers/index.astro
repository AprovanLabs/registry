---
import { ProviderExplorer } from "@/components/ProviderExplorer";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBasePath } from "@/lib/site";
---

<BaseLayout
  title="Tool Catalog · Aprovan Registry"
  description="Browse every provider and tool in the UTDK registry. Search by name, path, or summary."
>
  <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
    <section class="flex flex-col gap-3">
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Browse every tool.
      </h1>
      <p class="max-w-2xl text-muted-foreground">
        Search across all providers and tools. Data loads from static catalog JSON —
        open a provider to try any operation.
      </p>
      <div class="flex gap-3 text-sm">
        <a
          class="font-medium text-primary underline-offset-4 hover:underline"
          href={withBasePath("/")}
        >
          ← Package browser
        </a>
      </div>
    </section>

    <ProviderExplorer client:only="react">
      <p slot="fallback" class="text-sm text-muted-foreground">Loading catalog…</p>
    </ProviderExplorer>
  </main>
</BaseLayout>
