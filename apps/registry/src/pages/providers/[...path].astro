---
import { TryItConsole } from "@/components/TryItConsole";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadProviderOperations } from "@/lib/openapi";
import { getRegistryCatalog, getRegistryEntry } from "@/lib/registry";
import { withBasePath } from "@/lib/site";

export async function getStaticPaths() {
  const catalog = await getRegistryCatalog();
  const paths: Array<{
    params: { path: string };
    props: {
      providerPath: string;
      operationId: string;
    };
  }> = [];

  for (const entry of catalog.entries) {
    if (entry.kind !== "provider") continue;

    const operations = await loadProviderOperations(entry.providerPath);

    for (const op of operations) {
      // URL path = providerPath + "/" + operationId
      // e.g. "github" + "/" + "users/get-by-username" → "github/users/get-by-username"
      paths.push({
        params: { path: `${entry.providerPath}/${op.operationId}` },
        props: {
          providerPath: entry.providerPath,
          operationId: op.operationId,
        },
      });
    }
  }

  return paths;
}

interface Props {
  providerPath: string;
  operationId: string;
}

const { providerPath, operationId } = Astro.props;

const [entry, allOperations] = await Promise.all([
  getRegistryEntry(providerPath),
  loadProviderOperations(providerPath),
]);

if (!entry) {
  throw new Error(`Unknown registry entry: ${providerPath}`);
}

const operation = allOperations.find((op) => op.operationId === operationId);

if (!operation) {
  throw new Error(`Unknown operation "${operationId}" for provider "${providerPath}"`);
}

const pageTitle = `${operation.summary ?? operation.sdkPath} · ${entry.title} · Aprovan Registry`;
const providerHref = withBasePath(`/packages/${entry.providerPath}`);
const defaultGatewayUrl = import.meta.env.PUBLIC_GATEWAY_URL ?? "";

// Group other operations for the sidebar (same tags first, then all)
const sameTagOps = operation.tags.length
  ? allOperations
      .filter(
        (op) =>
          op.operationId !== operationId &&
          op.tags.some((t) => operation.tags.includes(t)),
      )
      .slice(0, 10)
  : [];

const totalOps = allOperations.length;
---

<BaseLayout
  description={operation.summary ?? `Try ${operation.sdkPath} from ${entry.title}`}
  title={pageTitle}
>
  <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-3">
      <nav class="flex items-center gap-1.5 text-sm text-muted-foreground">
        <a
          class="transition-colors hover:text-foreground"
          href={withBasePath("/")}
        >
          Aprovan Registry
        </a>
        <span>/</span>
        <a
          class="transition-colors hover:text-foreground"
          href={providerHref}
        >
          {entry.title}
        </a>
        <span>/</span>
        <span class="font-mono text-foreground">{operation.sdkPath}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <Badge>{entry.kind}</Badge>
        {operation.tags.map((tag) => (
          <Badge variant="secondary">{tag}</Badge>
        ))}
        <span class="flex items-center gap-1.5 rounded border border-border px-2 py-0.5 text-xs">
          <span
            class:list={[
              "font-mono text-[0.6rem] font-medium uppercase",
              operation.httpMethod === "GET" && "text-emerald-500",
              operation.httpMethod === "POST" && "text-blue-500",
              operation.httpMethod === "PUT" && "text-amber-500",
              operation.httpMethod === "PATCH" && "text-orange-500",
              operation.httpMethod === "DELETE" && "text-red-500",
            ]}
          >
            {operation.httpMethod}
          </span>
          <code class="font-mono text-xs text-muted-foreground">{operation.httpPath}</code>
        </span>
      </div>
    </header>

    <div class="grid gap-6 xl:grid-cols-[260px_minmax(0,1fr)_240px]">
      <!-- Left sidebar: provider operations list -->
      <aside class="hidden xl:block">
        <Card size="sm">
          <CardHeader>
            <CardTitle>Operations</CardTitle>
            <CardDescription>
              {totalOps} operation{totalOps === 1 ? "" : "s"} in {entry.title}.
            </CardDescription>
          </CardHeader>
          <CardContent className="flex flex-col gap-0.5 max-h-[600px] overflow-y-auto">
            {allOperations.map((op) => {
              const isActive = op.operationId === operationId;
              const href = withBasePath(`/providers/${providerPath}/${op.operationId}`);
              return (
                <a
                  class:list={[
                    "rounded-lg px-2.5 py-2 text-xs transition-colors",
                    isActive
                      ? "bg-accent text-accent-foreground"
                      : "text-muted-foreground hover:bg-muted hover:text-foreground",
                  ]}
                  href={href}
                >
                  <span class="block font-mono">{op.operationId}</span>
                  {op.summary && (
                    <span class="block truncate opacity-70">{op.summary}</span>
                  )}
                </a>
              );
            })}
          </CardContent>
        </Card>
      </aside>

      <!-- Main content -->
      <section class="flex flex-col gap-6">
        <!-- Operation overview -->
        <Card>
          <CardHeader>
            <div class="flex flex-wrap items-center gap-2">
              <Badge variant="outline">
                <span class="font-mono">{entry.packageName}</span>
              </Badge>
              <code class="rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">
                {operation.httpPath}
              </code>
            </div>
            <CardTitle className="text-2xl font-semibold">
              {operation.summary ?? operationId}
            </CardTitle>
            {operation.description && (
              <CardDescription className="leading-6">
                {operation.description}
              </CardDescription>
            )}
          </CardHeader>

          {(operation.parameters.length > 0 || operation.requestBodyFields.length > 0) && (
            <CardContent>
              <dl class="grid gap-2 sm:grid-cols-2">
                {operation.parameters.map((param) => (
                  <div class="rounded-lg border bg-muted/30 p-3">
                    <dt class="flex flex-wrap items-center gap-1.5 font-mono text-sm font-medium">
                      {param.name}
                      <Badge variant="secondary" className="font-mono text-[0.65rem]">
                        {param.location}
                      </Badge>
                      {param.required && (
                        <Badge variant="destructive" className="text-[0.65rem]">
                          required
                        </Badge>
                      )}
                    </dt>
                    {param.description && (
                      <dd class="mt-1 text-xs text-muted-foreground line-clamp-2">
                        {param.description}
                      </dd>
                    )}
                    {param.schema.type && (
                      <dd class="mt-1 font-mono text-xs text-muted-foreground">
                        {param.schema.enum
                          ? `enum: ${param.schema.enum.slice(0, 4).map(String).join(", ")}${param.schema.enum.length > 4 ? "…" : ""}`
                          : param.schema.type}
                      </dd>
                    )}
                  </div>
                ))}
              </dl>
            </CardContent>
          )}
        </Card>

        <!-- Try-it console -->
        <div>
          <h2 class="mb-4 text-xl font-semibold tracking-tight">Try it</h2>
          <TryItConsole
            client:load
            defaultGatewayUrl={defaultGatewayUrl}
            operation={operation}
            provider={providerPath}
            providerTitle={entry.title}
          />
        </div>
      </section>

      <!-- Right sidebar -->
      <aside class="flex flex-col gap-6">
        <!-- Back to provider -->
        <Card size="sm">
          <CardHeader>
            <CardTitle>Provider</CardTitle>
          </CardHeader>
          <CardContent>
            <a
              class="block rounded-lg border bg-muted/40 px-3 py-2 text-sm font-medium transition-colors hover:bg-muted"
              href={providerHref}
            >
              {entry.title}
              <span class="block font-mono text-xs text-muted-foreground">
                {entry.packageName}
              </span>
            </a>
          </CardContent>
        </Card>

        <!-- Related operations (same tags) -->
        {sameTagOps.length > 0 && (
          <Card size="sm">
            <CardHeader>
              <CardTitle>Related</CardTitle>
              <CardDescription>Same tag{operation.tags.length > 1 ? "s" : ""}.</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-col gap-0.5">
              {sameTagOps.map((op) => (
                <a
                  class="rounded-lg px-2.5 py-2 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                  href={withBasePath(`/providers/${providerPath}/${op.operationId}`)}
                >
                  <span class="block font-mono">{op.operationId}</span>
                  {op.summary && (
                    <span class="block truncate opacity-70">{op.summary}</span>
                  )}
                </a>
              ))}
            </CardContent>
          </Card>
        )}
      </aside>
    </div>
  </main>
</BaseLayout>
