---
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContract, getContracts } from "@/lib/contracts";
import { withBasePath } from "@/lib/site";

export async function getStaticPaths() {
  const contracts = await getContracts();
  return contracts.map((contract) => ({ params: { id: contract.id } }));
}

const { id } = Astro.params;
const contract = id ? await getContract(id) : undefined;

if (!contract) {
  throw new Error(`Unknown interface: ${id}`);
}
---

<BaseLayout
  title={`${contract.label} interface · Aprovan Registry`}
  description={contract.description ?? undefined}
>
  <main class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-3">
      <a
        class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        href={withBasePath("/interfaces")}
      >
        ← Interfaces
      </a>
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="outline" className="font-mono">{contract.packageName}</Badge>
        {contract.version ? <Badge variant="secondary">v{contract.version}</Badge> : null}
        <Badge>
          {contract.compat.length} implementer{contract.compat.length === 1 ? "" : "s"}
        </Badge>
      </div>
      <h1 class="text-3xl font-semibold tracking-tight">{contract.label}</h1>
      {contract.description ? (
        <p class="max-w-3xl leading-7 text-muted-foreground">{contract.description}</p>
      ) : null}
      <div class="flex gap-3 text-sm">
        <a
          class="font-medium text-primary underline-offset-4 hover:underline"
          href={contract.npmUrl}
          rel="noreferrer"
          target="_blank"
        >
          {contract.packageName} on npm ↗
        </a>
      </div>
    </header>

    {contract.operations.length > 0 ? (
      <Card>
        <CardHeader>
          <CardTitle>Operations</CardTitle>
          <CardDescription>
            The contract surface, from the package's own tool-entry factory — the same
            metadata every implementing provider module exports.
          </CardDescription>
        </CardHeader>
        <CardContent className="overflow-x-auto">
          <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b text-xs text-muted-foreground">
                <th class="py-2 pr-4 font-medium">Operation</th>
                <th class="py-2 pr-4 font-medium">Required args</th>
                <th class="py-2 font-medium">Description</th>
              </tr>
            </thead>
            <tbody>
              {contract.operations.map((operation) => (
                <tr class="border-b last:border-b-0 align-top">
                  <td class="py-2.5 pr-4 font-mono text-xs whitespace-nowrap">
                    {contract.id}.{operation.name}
                  </td>
                  <td class="py-2.5 pr-4 font-mono text-xs">
                    {operation.requiredArgs.length > 0
                      ? operation.requiredArgs.join(", ")
                      : "—"}
                  </td>
                  <td class="py-2.5 text-muted-foreground">{operation.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </CardContent>
      </Card>
    ) : null}

    <Card>
      <CardHeader>
        <CardTitle>Implementations</CardTitle>
        <CardDescription>
          {contract.compatSource
            ? "Generated from the chat-provider registry — the compat list and the chat picker stay in lockstep."
            : "Registry providers committed to this contract, with their adapter modules."}
        </CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-3">
        {contract.compat.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            No registry providers implement this contract yet — the surface is published
            and frozen, and adapter contributions are welcome.
          </p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b text-xs text-muted-foreground">
                  <th class="py-2 pr-4 font-medium">Provider</th>
                  <th class="py-2 pr-4 font-medium">Adapter module</th>
                  <th class="py-2 font-medium">Availability</th>
                </tr>
              </thead>
              <tbody>
                {contract.compat.map((entry) => (
                  <tr class="border-b last:border-b-0 align-top">
                    <td class="py-2.5 pr-4 whitespace-nowrap">
                      {entry.providerPath ? (
                        <a
                          class="font-medium text-primary underline-offset-4 hover:underline"
                          href={withBasePath(`/packages/${entry.providerPath}`)}
                        >
                          {entry.label}
                        </a>
                      ) : (
                        <span class={entry.available ? "font-medium" : "font-medium text-muted-foreground"}>
                          {entry.label}
                        </span>
                      )}
                    </td>
                    <td class="py-2.5 pr-4 font-mono text-xs whitespace-nowrap">
                      {entry.moduleSpecifier ?? entry.module}
                    </td>
                    <td class="py-2.5">
                      <div class="flex flex-wrap items-center gap-2">
                        {entry.available ? (
                          <Badge>available</Badge>
                        ) : (
                          <Badge variant="outline">not yet built</Badge>
                        )}
                        {entry.credentialless ? (
                          <Badge variant="secondary">credentialless</Badge>
                        ) : null}
                        {(entry.capabilities ?? []).map((capability) => (
                          <Badge variant="secondary">{capability}</Badge>
                        ))}
                      </div>
                      {entry.unavailable ? (
                        <p class="mt-1.5 max-w-md text-xs text-muted-foreground">
                          {entry.unavailable}
                        </p>
                      ) : null}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </CardContent>
    </Card>
  </main>
</BaseLayout>
