---
import { HomeSandboxDemo } from "@/components/HomeSandboxDemo";
import { RegistryBrowser } from "@/components/RegistryBrowser";
import { SnippetCarousel } from "@/components/SnippetCarousel";
import { Badge } from "@/components/ui/badge";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRegistryCatalog } from "@/lib/registry";
import { withBasePath } from "@/lib/site";

const catalog = await getRegistryCatalog();
const updatedAtLabel = catalog.updatedAt
  ? new Date(catalog.updatedAt).toLocaleString("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
    })
  : null;
const providerEntries = catalog.entries.filter((entry) => entry.kind === "provider");
const preferredProviderPaths = ["github", "figma", "openai", "stripe", "slack"];
const featuredEntries = [
  ...preferredProviderPaths
    .map((providerPath) =>
      providerEntries.find((entry) => entry.providerPath === providerPath),
    )
    .filter((entry): entry is (typeof providerEntries)[number] => Boolean(entry)),
  ...providerEntries.slice(0, 4),
]
  .filter(
    (entry, index, entries) =>
      entries.findIndex((candidate) => candidate.providerPath === entry.providerPath) ===
      index,
  )
  .slice(0, 5);

const snippetItems = featuredEntries.map((entry) => {
  if (entry.providerPath === "github") {
    return {
      providerPath: entry.providerPath,
      providerTitle: entry.title,
      iconUrl: entry.openApiIcon,
      code: `import github from '@utdk/github';
await github.users.getByUsername({ username: 'octocat' });`,
    };
  }

  return {
    providerPath: entry.providerPath,
    providerTitle: entry.title,
    iconUrl: entry.openApiIcon,
    code: entry.importSample,
  };
});
---

<BaseLayout title="Aprovan Registry">
  <main class="flex flex-col w-full min-h-screen gap-8 px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <section class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="outline">{catalog.providerCount} providers</Badge>
        <Badge variant="secondary">{catalog.namespaceCount} namespaces</Badge>
        {updatedAtLabel ? <Badge variant="outline">Updated {updatedAtLabel}</Badge> : null}
      </div>
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Every API is an SDK.
      </h1>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground">
        Import any provider as
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm text-syntax-string">@utdk/&lt;name&gt;</code>
        and your script runs in a sandboxed isolate — in the browser or on the
        gateway — where providers are live namespaces:
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm"><span class="text-syntax-keyword">await</span> <span class="text-syntax-type">github</span>.<span class="text-syntax-fn">getRepos</span>({"{"} username {"}"})</code>
        just works. The sandbox only speaks to the gateway; credentials are
        injected server-side and never enter your code.
        <a class="font-medium underline underline-offset-4 hover:text-foreground" href={withBasePath("/playground")}>Run a script live →</a>
      </p>
    </section>

    <SnippetCarousel client:load items={snippetItems} />

    <HomeSandboxDemo client:only="react" />

    <section class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <h2 class="text-2xl font-semibold tracking-tight">Providers</h2>
        <p class="text-sm text-muted-foreground">Search by name or contents.</p>
      </div>
      <RegistryBrowser
        client:load
        entries={catalog.entries.map((entry) => ({
          kind: entry.kind,
          providerPath: entry.providerPath,
          packageName: entry.packageName,
          title: entry.title,
          summary: entry.summary,
          parentProviderPath: entry.parentProviderPath,
          docsCount: entry.docs.length + (entry.readmeHtml ? 1 : 0),
          operationCount: entry.operationCount,
          openApiIcon: entry.openApiIcon,
        }))}
      />
    </section>
  </main>
</BaseLayout>
