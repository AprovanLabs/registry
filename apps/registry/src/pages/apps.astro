---
/**
 * Legacy route: the Apps panel was removed from the catalog. Redirect to the
 * Playground so old links and bookmarks land on a useful surface.
 */
import { withBasePath } from "@/lib/site";

const target = withBasePath("/playground/");
const canonical = Astro.site ? new URL(target, Astro.site).href : target;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Playground — Aprovan Registry</title>
    <meta content="noindex" name="robots" />
    <link href={canonical} rel="canonical" />
    <meta content={`0;url=${target}`} http-equiv="refresh" />
  </head>
  <body>
    <p>
      Apps have moved out of the catalog.
      <a href={target}>Continue to Playground</a>.
    </p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
