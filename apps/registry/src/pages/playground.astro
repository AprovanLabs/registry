---
import { ScriptPlayground } from "@/components/ScriptPlayground";
import { Badge } from "@/components/ui/badge";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  description="Run TypeScript against any registry provider in a sandboxed browser runtime — calls proxy through the gateway with your workspace credentials."
  title="Playground — Aprovan Registry"
>
  <main class="flex flex-col w-full min-h-screen gap-6 px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <section class="flex flex-col gap-3">
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        The sandbox, live.
      </h1>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground">
        Write a script that imports providers —
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm"><span class="text-syntax-keyword">import</span> github <span class="text-syntax-keyword">from</span> <span class="text-syntax-string">'@utdk/github'</span></code>
        — and run it here. The script executes in a sandboxed isolate; every call
        proxies to the gateway, which injects your workspace credentials
        server-side. The sandbox never sees a secret.
      </p>
    </section>

    <ScriptPlayground client:only="react" />
  </main>
</BaseLayout>
