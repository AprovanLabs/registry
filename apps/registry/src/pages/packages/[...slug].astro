---
import { CopyButton } from "@/components/CopyButton";
import MarkdownInline from "@/components/MarkdownInline.astro";
import MarkdownContent from "@/components/MarkdownContent.astro";
import { HighlightedCode } from "@aprovan/editor";
import { SdkExplorer } from "@/components/SdkExplorer";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProviderImplementsIndex } from "@/lib/contracts";
import {
  getDocPage,
  getRegistryCatalog,
  getRegistryEntry,
  getRegistryRoutes,
} from "@/lib/registry";
import { buildSdkSymbols } from "@/lib/sdk";
import { withBasePath } from "@/lib/site";

export async function getStaticPaths() {
  const routes = await getRegistryRoutes();

  return routes.map((route) => ({
    params: { slug: route.slug.join("/") },
    props: route,
  }));
}

interface Props {
  providerPath: string;
  docSlug: string | null;
}

const { providerPath, docSlug } = Astro.props;
const [catalog, entry] = await Promise.all([
  getRegistryCatalog(),
  getRegistryEntry(providerPath),
]);

if (!entry) {
  throw new Error(`Unknown registry entry: ${providerPath}`);
}

const operations = entry.operations;

const activeDoc = getDocPage(entry, docSlug);
const overviewHref = withBasePath(`/packages/${entry.providerPath}`);
const pageTitle = activeDoc
  ? `${activeDoc.title} · ${entry.title} · Aprovan Registry`
  : `${entry.title} · Aprovan Registry`;
const generatedAtLabel = entry.generatedAt
  ? new Date(entry.generatedAt).toLocaleString("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
    })
  : null;
const childEntries = entry.childProviderPaths
  .map((childPath) =>
    catalog.entries.find((candidate) => candidate.providerPath === childPath),
  )
  .filter(
    (
      childEntry,
    ): childEntry is NonNullable<
      (typeof catalog.entries)[number] | undefined
    > => Boolean(childEntry),
  );
const parentEntry = entry.parentProviderPath
  ? catalog.entries.find(
      (candidate) => candidate.providerPath === entry.parentProviderPath,
    ) ?? null
  : null;
const sdkSymbols = entry.kind === "provider" ? buildSdkSymbols(entry) : [];
const logoUrl = entry.branding?.logo ?? entry.openApiIcon;
const siteUrl = entry.branding?.site ?? entry.homepage;
const originDomain = entry.provenance?.originDomain ?? null;
// Chain-of-ownership rule: link the vendor's original spec, never the
// aggregator cache we fetched through.
const specUrl = entry.provenance?.originSpecUrl ?? entry.openApiUrl;
// Contracts this provider implements (compat entries naming it). Absent for
// most providers — the section renders only when entries exist.
const implementsIndex = await getProviderImplementsIndex();
const implementsEntries = implementsIndex.get(entry.providerPath) ?? [];
// Webhook intel renders only for providers that can actually deliver hooks.
const webhookIntel = entry.webhookIntel?.supported ? entry.webhookIntel : null;
const MAX_WEBHOOK_EVENTS = 12;
const visibleWebhookEvents = webhookIntel?.events.slice(0, MAX_WEBHOOK_EVENTS) ?? [];
const hiddenWebhookEventCount = webhookIntel
  ? Math.max(0, webhookIntel.events.length - MAX_WEBHOOK_EVENTS)
  : 0;
---

<BaseLayout
  description={entry.summary ?? entry.description ?? undefined}
  title={pageTitle}
>
  <main class="mx-auto flex min-h-screen min-w-0 w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-3">
      <a
        class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        href={withBasePath("/")}
      >
        Aprovan Registry
      </a>
      <div class="flex flex-wrap items-center gap-2">
        <Badge>{entry.kind}</Badge>
        <Badge variant="outline">{entry.operationCount} operations</Badge>
      </div>
    </header>

    <div class="grid min-w-0 gap-6 xl:grid-cols-[240px_minmax(0,1fr)_260px]">
      <aside class="hidden xl:block">
        <Card size="sm">
          <CardHeader>
            <CardTitle>All packages</CardTitle>
            <CardDescription>Browse the current generated catalog.</CardDescription>
          </CardHeader>
          <CardContent className="flex flex-col gap-1">
            {catalog.entries.map((candidate) => {
              const isActive = candidate.providerPath === entry.providerPath;

              return (
                <a
                  class:list={[
                    "rounded-lg px-2.5 py-2 text-sm transition-colors",
                    isActive
                      ? "bg-accent text-accent-foreground"
                      : "text-muted-foreground hover:bg-muted hover:text-foreground",
                  ]}
                  href={withBasePath(`/packages/${candidate.providerPath}`)}
                >
                  <span class="block truncate font-medium">{candidate.title}</span>
                  <span class="block truncate font-mono text-xs opacity-80">
                    {candidate.packageName}
                  </span>
                </a>
              );
            })}
          </CardContent>
        </Card>
      </aside>

      <section class="flex min-w-0 flex-col gap-6">
        <Card>
          <CardHeader>
            <div class="col-start-1 flex flex-wrap items-center gap-2">
              <Badge variant="outline">{entry.packageName}</Badge>
              {parentEntry ? (
                <a
                  class="inline-flex h-5 items-center rounded-4xl border border-border px-2 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                  href={withBasePath(`/packages/${parentEntry.providerPath}`)}
                >
                  Parent: {parentEntry.title}
                </a>
              ) : null}
            </div>
            <div class="col-start-1 flex items-center gap-3">
              {logoUrl ? (
                <img
                  alt=""
                  class="size-10 shrink-0 rounded-lg border bg-background object-contain p-1"
                  height="40"
                  loading="lazy"
                  src={logoUrl}
                  width="40"
                />
              ) : null}
              <CardTitle className="text-3xl">{entry.title}</CardTitle>
            </div>
            {originDomain ? (
              <p class="col-start-1 break-all font-mono text-xs text-muted-foreground">
                <span class="text-syntax-type">{entry.providerPath}</span>
                {" · owned by "}
                {siteUrl ? (
                  <a class="underline-offset-4 hover:underline" href={siteUrl} rel="noreferrer" target="_blank">
                    {originDomain}
                  </a>
                ) : (
                  originDomain
                )}
                {specUrl ? (
                  <>
                    {" · "}
                    <a class="underline-offset-4 hover:underline" href={specUrl} rel="noreferrer" target="_blank">
                      original spec
                    </a>
                  </>
                ) : null}
              </p>
            ) : null}
            <CardDescription className="text-base leading-7">
              {entry.descriptionHtml ? (
                <MarkdownInline html={entry.descriptionHtml} />
              ) : (
                entry.description ??
                "Generated UTDK package with filesystem-discovered metadata and docs."
              )}
            </CardDescription>
            <CardAction className="hidden md:block">
              <CopyButton client:load idleLabel="Copy package" text={entry.packageName} />
            </CardAction>
          </CardHeader>
          <CardContent className="flex flex-col gap-4">
            <div class="grid gap-4 lg:grid-cols-2">
              <div class="rounded-xl border bg-muted/50 p-4">
                <div class="mb-3 flex items-center justify-between gap-3">
                  <p class="text-sm font-medium">Import sample</p>
                  <CopyButton
                    client:load
                    idleLabel="Copy"
                    size="xs"
                    text={entry.importSample}
                  />
                </div>
                <div class="overflow-x-auto rounded-lg bg-background p-3 text-sm"><HighlightedCode code={entry.importSample} /></div>
              </div>

              {entry.createClientSample ? (
                <div class="rounded-xl border bg-muted/50 p-4">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <p class="text-sm font-medium">Factory sample</p>
                    <CopyButton
                      client:load
                      idleLabel="Copy"
                      size="xs"
                      text={entry.createClientSample}
                    />
                  </div>
                  <div class="overflow-x-auto rounded-lg bg-background p-3 text-sm"><HighlightedCode code={entry.createClientSample} /></div>
                </div>
              ) : (
                <div class="rounded-xl border bg-muted/50 p-4">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <p class="text-sm font-medium">Package name</p>
                    <CopyButton
                      client:load
                      idleLabel="Copy"
                      size="xs"
                      text={entry.packageName}
                    />
                  </div>
                  <pre class="overflow-x-auto rounded-lg bg-background p-3 text-sm"><code>{entry.packageName}</code></pre>
                </div>
              )}
            </div>

          </CardContent>
        </Card>

        {activeDoc ? (
          <Card>
            <CardHeader>
              <a
                class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
                href={overviewHref}
              >
                ← Back to {entry.title}
              </a>
              <CardTitle>{activeDoc.title}</CardTitle>
              <CardDescription>
                Generated reference page for <code>{entry.packageName}</code> — the
                interactive SDK explorer on the package overview is the canonical
                reference.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <MarkdownContent html={activeDoc.html} />
            </CardContent>
          </Card>
        ) : (
          <>
            {operations.length > 0 && (
              <SdkExplorer
                client:load
                packageName={entry.packageName}
                provider={entry.providerPath}
                symbols={sdkSymbols}
              />
            )}

            {implementsEntries.length > 0 ? (
              <Card>
                <CardHeader>
                  <CardTitle>Implements</CardTitle>
                  <CardDescription>
                    Shared UTDK contracts this provider speaks — bind the interface
                    namespace and the adapter module executes it.
                  </CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-3">
                  {implementsEntries.map(({ contractId, contractPackageName, entry: compat }) => (
                    <div class="flex flex-col gap-1.5 rounded-xl border bg-muted/40 p-4">
                      <div class="flex flex-wrap items-center gap-2">
                        <a
                          class="font-medium text-primary underline-offset-4 hover:underline"
                          href={withBasePath(`/interfaces/${contractId}`)}
                        >
                          {contractPackageName}
                        </a>
                        <span class="font-mono text-xs text-muted-foreground">
                          via {compat.moduleSpecifier ?? compat.module}
                        </span>
                        {compat.available ? (
                          <Badge>available</Badge>
                        ) : (
                          <Badge variant="outline">not yet built</Badge>
                        )}
                        {compat.credentialless ? (
                          <Badge variant="secondary">credentialless</Badge>
                        ) : null}
                        {(compat.capabilities ?? []).map((capability) => (
                          <Badge variant="secondary">{capability}</Badge>
                        ))}
                      </div>
                      {compat.unavailable ? (
                        <p class="text-xs text-muted-foreground">{compat.unavailable}</p>
                      ) : null}
                    </div>
                  ))}
                </CardContent>
              </Card>
            ) : null}

            {entry.authIntel ? (
              <Card>
                <CardHeader>
                  <CardTitle>Authentication</CardTitle>
                  <CardDescription>{entry.authIntel.summary}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-3">
                  <div class="flex flex-wrap gap-2">
                    {entry.authIntel.methods.map((method) => (
                      <Badge variant="secondary">{method}</Badge>
                    ))}
                    {entry.authIntel.apiKeyHeader ? (
                      <Badge variant="outline">header: {entry.authIntel.apiKeyHeader}</Badge>
                    ) : null}
                  </div>
                  {entry.authIntel.setupSteps.length > 0 ? (
                    <ol class="flex list-decimal flex-col gap-2 pl-5 text-sm">
                      {entry.authIntel.setupSteps.map((step) => (
                        <li>
                          <span class="font-medium">{step.title}</span>
                          <span class="text-muted-foreground"> — {step.detail}</span>
                        </li>
                      ))}
                    </ol>
                  ) : null}
                  <p class="text-xs text-muted-foreground">
                    Credentials are managed in the product workspace app; the gateway
                    injects them on every call.
                  </p>
                </CardContent>
              </Card>
            ) : null}

            {webhookIntel ? (
              <Card>
                <CardHeader>
                  <CardTitle>Webhooks</CardTitle>
                  <CardDescription>{webhookIntel.summary}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-3">
                  <div class="flex flex-wrap gap-2">
                    {webhookIntel.configMethods.map((method) => (
                      <Badge variant="secondary">
                        {method === "console" ? "console setup" : "api setup"}
                      </Badge>
                    ))}
                    {webhookIntel.signature?.header ? (
                      <Badge variant="outline">
                        signature: {webhookIntel.signature.header}
                      </Badge>
                    ) : null}
                    {webhookIntel.payloadFormat ? (
                      <Badge variant="outline">{webhookIntel.payloadFormat}</Badge>
                    ) : null}
                  </div>
                  {visibleWebhookEvents.length > 0 ? (
                    <div class="flex flex-col gap-1.5">
                      <p class="text-sm font-medium">Events</p>
                      <ul class="flex flex-col gap-1 text-sm">
                        {visibleWebhookEvents.map((event) => (
                          <li>
                            <code class="font-mono text-xs">{event.name}</code>
                            <span class="text-muted-foreground"> — {event.description}</span>
                          </li>
                        ))}
                      </ul>
                      {hiddenWebhookEventCount > 0 ? (
                        <p class="text-xs text-muted-foreground">
                          +{hiddenWebhookEventCount} more events
                        </p>
                      ) : null}
                    </div>
                  ) : null}
                  {webhookIntel.setupSteps.length > 0 ? (
                    <ol class="flex list-decimal flex-col gap-2 pl-5 text-sm">
                      {webhookIntel.setupSteps.map((step) => (
                        <li>
                          <span class="font-medium">{step.title}</span>
                          <span class="text-muted-foreground"> — {step.detail}</span>
                        </li>
                      ))}
                    </ol>
                  ) : null}
                  <p class="text-xs text-muted-foreground">
                    Register in your workspace: webhook registrations are managed from the
                    Workflows panel (or the gateway <code>webhooks.*</code> tools) and receive
                    deliveries at{" "}
                    <code>
                      https://aprovan.com/api/gateway/hooks/&lt;workspace&gt;/webhooks/&lt;id&gt;?token=…
                    </code>
                    .
                  </p>
                  {webhookIntel.docsUrl ? (
                    <a
                      class="text-xs font-medium text-primary underline-offset-4 hover:underline"
                      href={webhookIntel.docsUrl}
                      rel="noreferrer"
                      target="_blank"
                    >
                      Provider webhook docs ↗
                    </a>
                  ) : null}
                </CardContent>
              </Card>
            ) : null}

            {entry.readmeHtml ? (
              <Card>
                <CardHeader>
                  <CardTitle>README</CardTitle>
                  <CardDescription>
                    Embedded directly from the package source.
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <MarkdownContent html={entry.readmeHtml} />
                </CardContent>
              </Card>
            ) : null}

            {childEntries.length ? (
              <Card>
                <CardHeader>
                  <CardTitle>Child packages</CardTitle>
                  <CardDescription>
                    Separate nested APIs available through this parent namespace.
                  </CardDescription>
                </CardHeader>
                <CardContent className="grid gap-3 sm:grid-cols-2">
                  {childEntries.map((childEntry) => (
                    <a
                      class="rounded-xl border bg-muted/40 p-4 transition-colors hover:bg-muted"
                      href={withBasePath(`/packages/${childEntry.providerPath}`)}
                    >
                      <p class="font-medium">{childEntry.title}</p>
                      <p class="mt-1 font-mono text-xs text-muted-foreground">
                        {childEntry.packageName}
                      </p>
                    </a>
                  ))}
                </CardContent>
              </Card>
            ) : null}
          </>
        )}
      </section>

      <aside class="flex min-w-0 flex-col gap-6">
        <Card size="sm">
          <CardHeader>
            <CardTitle>About</CardTitle>
          </CardHeader>
          <CardContent className="flex flex-col gap-2.5 text-sm">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-xs text-muted-foreground">Provider</span>
              <code class="break-all font-mono text-xs">{entry.providerPath}</code>
            </div>
            {entry.openApiVersion ?? entry.version ? (
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-xs text-muted-foreground">Version</span>
                <span class="text-xs">{entry.openApiVersion ?? entry.version}</span>
              </div>
            ) : null}
            {generatedAtLabel ? (
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-xs text-muted-foreground">Generated</span>
                <span class="text-xs">{generatedAtLabel}</span>
              </div>
            ) : null}
            {siteUrl || specUrl ? <Separator /> : null}
            {siteUrl ? (
              <a
                class="text-xs font-medium text-primary underline-offset-4 hover:underline"
                href={siteUrl}
                rel="noreferrer"
                target="_blank"
              >
                Vendor site ↗
              </a>
            ) : null}
            {specUrl ? (
              <a
                class="text-xs font-medium text-primary underline-offset-4 hover:underline"
                href={specUrl}
                rel="noreferrer"
                target="_blank"
              >
                Original API spec ↗
              </a>
            ) : null}
          </CardContent>
        </Card>

        {parentEntry ? (
          <Card size="sm">
            <CardHeader>
              <CardTitle>Parent package</CardTitle>
              <CardDescription>
                This nested package belongs to a broader namespace entry.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <a
                class="rounded-lg border bg-muted/40 px-3 py-2 text-sm font-medium transition-colors hover:bg-muted"
                href={withBasePath(`/packages/${parentEntry.providerPath}`)}
              >
                {parentEntry.title}
              </a>
            </CardContent>
          </Card>
        ) : null}
      </aside>
    </div>
  </main>
</BaseLayout>
