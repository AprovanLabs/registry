---
import "@/styles/global.css";
import { HeaderSession } from "@/components/shell/HeaderSession";
import { withBasePath } from "@/lib/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Browse published UTDK packages, copy package names, inspect generated docs, and connect MCP clients.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content={description} name="description" />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b bg-background/80 backdrop-blur">
      <nav class="flex items-center gap-4 sm:gap-6 px-4 py-3 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <a class="flex flex-row items-center gap-2 text-sm font-semibold transition-colors hover:text-foreground/80" href={withBasePath("/")}>
          <img class="w-6" src="https://github.com/AprovanLabs/aprovan.com/raw/refs/heads/main/docs/assets/social-icon.png"></img>
          Registry
        </a>
        <a
          class={`text-sm transition-colors ${currentPath.startsWith(withBasePath("/docs/mcp")) ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
          href={withBasePath("/docs/mcp")}
        >
          MCP
        </a>
        <a
          class={`text-sm transition-colors ${currentPath.startsWith(withBasePath("/playground")) ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
          href={withBasePath("/playground")}
        >
          Playground
        </a>
        <div class="flex items-center gap-4 ml-auto">
          <HeaderSession client:load />
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>
