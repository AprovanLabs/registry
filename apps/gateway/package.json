{
  "name": "@aprovan/registry-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API gateway — credential proxy, permission enforcement, and tool call routing",
  "exports": {
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./dist/contract.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:aws": "APROVAN_ENV=off STORE_BACKEND=dynamodb DYNAMO_ENDPOINT=http://localhost:8000 S3_ENDPOINT=http://localhost:9000 FS_BUCKET=aprovan-fs tsx watch src/index.ts",
    "bootstrap:local": "tsx scripts/bootstrap-local.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "create-tables": "tsx bin/create-tables.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aprovan/node": "^0.1.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.1077.0",
    "@aws-sdk/client-dynamodb": "^3.1077.0",
    "@aws-sdk/client-kms": "^3.1077.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/client-ses": "^3.1077.0",
    "@aws-sdk/lib-dynamodb": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "@jitl/quickjs-wasmfile-debug-asyncify": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@utdk/common": "workspace:*",
    "@utdk/llm": "workspace:*",
    "@utdk/mcp-core": "workspace:*",
    "aws-jwt-verify": "^4.0.1",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.6.20",
    "quickjs-emscripten-core": "0.32.0",
    "tslib": "^2.8.1",
    "utdk": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^2.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
