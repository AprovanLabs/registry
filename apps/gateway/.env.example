# Local overrides. Shared Cognito/identity tables load from SSM (APROVAN_ENV).
# Registry-specific DynamoDB tables are not in that SSM param — set them here.
APROVAN_ENV=prd
GATEWAY_PORT=4000
AWS_REGION=us-east-2

SESSIONS_TABLE=registry-prd-use2-sessions
CREDENTIALS_TABLE=registry-prd-use2-credentials
PERMISSIONS_TABLE=registry-prd-use2-permissions
AUDIT_TABLE=registry-prd-use2-audit-store
GROUPS_TABLE=registry-prd-use2-groups
GROUP_PREFIX_GRANTS_TABLE=registry-prd-use2-group-prefix-grants
GROUP_TOOL_GRANTS_TABLE=registry-prd-use2-group-tool-grants
USER_GROUPS_TABLE=registry-prd-use2-user-groups
USERGROUPS_TABLE=registry-prd-use2-user-groups
STORE_BACKEND=dynamodb
