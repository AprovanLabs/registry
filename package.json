{
  "name": "@aprovan/registry",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev --parallel",
    "lint": "eslint \"**/*.ts?(x)\"",
    "lint:fix": "eslint --fix \"**/*.ts?(x)\"",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "deploy": "pnpm run deploy:lib && pnpm run deploy:web",
    "deploy:web": "./scripts/deploy-web.sh",
    "deploy:lib": "./scripts/deploy-lib.sh",
    "update:registry": "./scripts/update-registry.sh",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@aprovan/eslint-config": "^1.0.0",
    "@aprovan/prettier-config": "^1.0.0",
    "@aprovan/tsconfig": "^0.1.0",
    "@aprovan/vitest-config": "^0.1.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.0.0",
    "lint-staged": "^13.0.3",
    "prettier": "^3.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "prettier": "@aprovan/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,md,scss}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  }
}
