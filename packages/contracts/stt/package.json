{
  "name": "@utdk/stt",
  "version": "0.1.2",
  "type": "module",
  "description": "Shared speech-to-text contract for UTDK: streaming sessions over caller-supplied audio, declared capabilities for diarization and word timestamps, and tool-discovery helpers",
  "keywords": [
    "stt",
    "speech-to-text",
    "transcription",
    "streaming",
    "utdk"
  ],
  "utdk": {
    "contract": "stt",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@utdk/common": "workspace:^0.1.2"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  },
  "files": [
    "dist",
    "compat.json",
    "AUDIT.md",
    "conformance.ts",
    "index.ts"
  ]
}
