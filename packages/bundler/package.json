{
  "name": "@aprovan/utdk-bundler",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Combine API definitions with documentation to automatically generate high-quality 3rd party integrations",
  "exports": {
    "./naming": {
      "types": "./dist/naming.d.ts",
      "import": "./dist/naming.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "generate": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@utcp/http": "^1.1.1",
    "@utcp/sdk": "^1.1.0",
    "@utdk/common": "workspace:*",
    "graphql": "^16.9.0",
    "openapi-types": "^12.1.3",
    "yaml": "^2.8.3"
  }
}