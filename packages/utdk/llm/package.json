{
  "name": "@utdk/llm",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared LLM contract for OpenAI-compatible chat providers: one message shape, chat-completion and model-listing engines, and tool-discovery helpers",
  "utdk": {
    "contract": "llm",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  }
}
