# UTDK provider E2E credentials
#
# Generated by `pnpm --filter @utdk/e2e env:scaffold` — do not hand-maintain the
# variable list; regenerate it when the provider matrix changes.
#
# Every variable is optional. A provider whose variables are blank is SKIPPED,
# never failed, so a partially-filled file is a valid state. Fill in the
# providers you care about and re-run `pnpm --filter @utdk/e2e test:live`.
#
# Check readiness at any time with: pnpm --filter @utdk/e2e doctor

# ---------------------------------------------------------------------------
# Gateway target (flows 3 and 4). Without this, only the direct-SDK flow runs.
#
# The gateway API is mounted under /api/gateway — only /health sits at the root,
# so a bare origin 404s on every endpoint. Local default port is 4000:
#   UTDK_E2E_GATEWAY_URL=http://localhost:4000/api/gateway
#
# Deployed: set the token to a Cognito access token for the workspace.
# ---------------------------------------------------------------------------
UTDK_E2E_GATEWAY_URL=
UTDK_E2E_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Airtable (airtable) — free signup
# Obtain: https://airtable.com/create/tokens
# Personal access token with scope schema.bases:read.
# ---------------------------------------------------------------------------
AIRTABLE_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic (anthropic) — free signup
# Obtain: https://platform.claude.com/settings/keys
# listModels is free; no token spend.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Asana (asana) — free signup
# Obtain: https://app.asana.com/0/my-apps
# Personal access token.
# ---------------------------------------------------------------------------
ASANA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Sandbox (cloudflare/sandbox) — free signup
# Obtain: https://dash.cloudflare.com/profile/api-tokens
# NOTE: no live probe yet — Sandbox driver, not a REST surface — probing it would provision billable compute. Covered by apps/workspace/tests/sandbox.test.ts and sandbox-scheduling.test.ts.
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Databricks SQL (databricks) — paid plan required
# Obtain: https://docs.databricks.com/dev-tools/auth.html
# PAT + SQL warehouse id. Warehouse must be running.
# ---------------------------------------------------------------------------
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HOST=

# ---------------------------------------------------------------------------
# Datadog (datadog) — signup, limited free tier
# Obtain: https://app.datadoghq.com/organization-settings/api-keys
# Needs BOTH DD-API-KEY and DD-APPLICATION-KEY; see notes.
# ---------------------------------------------------------------------------
DATADOG_API_KEY=

# ---------------------------------------------------------------------------
# DigitalOcean (digitalocean) — free signup
# Obtain: https://cloud.digitalocean.com/account/api/tokens
# Read-only PAT is sufficient.
# ---------------------------------------------------------------------------
DIGITALOCEAN_TOKEN=

# ---------------------------------------------------------------------------
# Discord (discord) — free signup
# Obtain: https://discord.com/developers/applications
# Bot token; the 'Bot ' prefix is added automatically.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# ElevenLabs (elevenlabs) — free signup
# Obtain: https://elevenlabs.io/app/settings/api-keys
# Free tier available. getUserInfo consumes no characters.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Figma (figma) — free signup
# Obtain: https://www.figma.com/developers/api#access-tokens
# Personal access token, file_read scope.
# ---------------------------------------------------------------------------
FIGMA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Fly.io Sprites (fly/sprites) — free signup
# Obtain: https://fly.io/user/personal_access_tokens
# NOTE: no live probe yet — Sandbox driver, not a REST surface — probing it would provision billable compute. Covered by apps/workspace/tests/sandbox.test.ts and sandbox-scheduling.test.ts.
# ---------------------------------------------------------------------------
FLY_API_TOKEN=

# ---------------------------------------------------------------------------
# Front (front) — no self-serve signup
# Obtain: https://app.frontapp.com/settings/tokens
# API token from Settings → API & Integrations.
# ---------------------------------------------------------------------------
FRONT_API_TOKEN=

# ---------------------------------------------------------------------------
# Google Gemini (gemini) — free signup
# Obtain: https://aistudio.google.com/apikey
# Free key from AI Studio; listModels costs nothing.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# GitHub (github) — free signup
# Obtain: https://github.com/settings/tokens
# Fine-grained PAT, no scopes needed for /user.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Google Cloud Run (google-cloud-run) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# cloud-platform scope + project id.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLOUD_PROJECT=

# ---------------------------------------------------------------------------
# Google Books (google/books) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# One OAuth client + refresh token covers every google/* provider; scope per API.
# ---------------------------------------------------------------------------
GOOGLE_BOOKS_USER_ID=

# ---------------------------------------------------------------------------
# Google Docs (google/docs) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# One OAuth client + refresh token covers every google/* provider; scope per API.
# ---------------------------------------------------------------------------
GOOGLE_DOC_ID=

# ---------------------------------------------------------------------------
# Google Forms (google/forms) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# One OAuth client + refresh token covers every google/* provider; scope per API.
# ---------------------------------------------------------------------------
GOOGLE_FORM_ID=

# ---------------------------------------------------------------------------
# Google Sheets (google/sheets) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# One OAuth client + refresh token covers every google/* provider; scope per API.
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------------
# Google Slides (google/slides) — free signup
# Obtain: https://console.cloud.google.com/apis/credentials
# One OAuth client + refresh token covers every google/* provider; scope per API.
# ---------------------------------------------------------------------------
GOOGLE_SLIDES_ID=

# ---------------------------------------------------------------------------
# HubSpot (hubspot) — free signup
# Obtain: https://developers.hubspot.com/docs/api/private-apps
# Private-app token with crm.objects.contacts.read.
# ---------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Intercom (intercom) — signup, limited free tier
# Obtain: https://app.intercom.com/a/apps/_/developer-hub
# Developer Hub → your app → access token.
# ---------------------------------------------------------------------------
INTERCOM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# IT Glue (itglue) — no self-serve signup
# Obtain: https://api.itglue.com/developer/
# MSP product — no self-serve signup.
# ---------------------------------------------------------------------------
ITGLUE_API_KEY=

# ---------------------------------------------------------------------------
# Jira (jira) — free signup
# Obtain: https://id.atlassian.com/manage-profile/security/api-tokens
# Atlassian API token + account email + site name.
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=

# ---------------------------------------------------------------------------
# LaunchDarkly (launchdarkly) — signup, limited free tier
# Obtain: https://app.launchdarkly.com/settings/authorization
# API access token (reader role is enough).
# ---------------------------------------------------------------------------
LAUNCHDARKLY_API_KEY=

# ---------------------------------------------------------------------------
# Linear (linear) — free signup
# Obtain: https://linear.app/settings/api
# Personal API key.
# ---------------------------------------------------------------------------
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# Mercury (mercury) — no self-serve signup
# Obtain: https://mercury.com/settings/tokens
# Read-only token. Requires an approved business bank account.
# ---------------------------------------------------------------------------
MERCURY_API_TOKEN=

# ---------------------------------------------------------------------------
# Notion (notion) — free signup
# Obtain: https://www.notion.so/my-integrations
# Internal integration secret; share a database with it and set NOTION_DATABASE_ID.
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# OpenAI (openai) — free signup
# Obtain: https://platform.openai.com/api-keys
# listModels is free; no token spend.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# OpenRouteService (openrouteservice) — free signup
# Obtain: https://openrouteservice.org/dev/#/signup
# Free key, 2000 req/day.
# ---------------------------------------------------------------------------
ORS_API_KEY=

# ---------------------------------------------------------------------------
# Pipedrive (pipedrive) — signup, limited free tier
# Obtain: https://pipedrive.readme.io/docs/how-to-find-the-api-token
# Personal API token from Settings.
# ---------------------------------------------------------------------------
PIPEDRIVE_API_TOKEN=

# ---------------------------------------------------------------------------
# Plaid (plaid) — free signup
# Obtain: https://dashboard.plaid.com/signup
# Sandbox keys are free; needs BOTH PLAID-CLIENT-ID and PLAID-SECRET.
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=

# ---------------------------------------------------------------------------
# Postgres (postgres) — free signup
# Obtain: https://neon.tech
# HTTP-SQL endpoint (Neon/Supabase) + bearer token.
# ---------------------------------------------------------------------------
POSTGRES_CONNECTION_TOKEN=
POSTGRES_HTTP_URL=

# ---------------------------------------------------------------------------
# PostHog (posthog) — free signup
# Obtain: https://us.posthog.com/settings/user-api-keys
# Personal API key + host (https://us.posthog.com or eu).
# ---------------------------------------------------------------------------
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Product Hunt (producthunt) — free signup
# Obtain: https://api.producthunt.com/v2/oauth/applications
# NOTE: no live probe yet — Generated surface is EMPTY (0 operations) — the bundler produced no metadata. Regeneration bug, see README findings.
# ---------------------------------------------------------------------------
PRODUCTHUNT_TOKEN=

# ---------------------------------------------------------------------------
# Salesforce (salesforce) — free signup
# Obtain: https://developer.salesforce.com/signup
# Free Developer Edition org; connected app with refresh_token scope.
# ---------------------------------------------------------------------------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_INSTANCE_URL=

# ---------------------------------------------------------------------------
# SendGrid (sendgrid) — signup, limited free tier
# Obtain: https://app.sendgrid.com/settings/api_keys
# Restricted key. getScopes sends no mail.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# Sentry (sentry) — free signup
# Obtain: https://sentry.io/settings/account/api/auth-tokens/
# Auth token with org:read.
# ---------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Slack (slack) — free signup
# Obtain: https://api.slack.com/apps
# Bot token (xoxb-…). authTest needs no scopes.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Snowflake SQL (snowflake) — signup, limited free tier
# Obtain: https://signup.snowflake.com
# 30-day trial; keypair-JWT or OAuth token.
# ---------------------------------------------------------------------------
SNOWFLAKE_TOKEN=
SNOWFLAKE_ACCOUNT=

# ---------------------------------------------------------------------------
# Spotify (spotify) — free signup
# Obtain: https://developer.spotify.com/dashboard
# user-read-private scope; one-time authorize to mint the refresh token.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Stripe (stripe) — free signup
# Obtain: https://dashboard.stripe.com/test/apikeys
# Use the TEST secret key (sk_test_…), never live.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stytch (stytch) — free signup
# Obtain: https://stytch.com/dashboard
# Test-environment project id + secret.
# NOTE: no live probe yet — No read-only identity operation in the generated surface — every op needs a user/session fixture. Needs a hand-picked probe; see README findings.
# ---------------------------------------------------------------------------
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# ---------------------------------------------------------------------------
# Twilio (twilio) — free signup
# Obtain: https://console.twilio.com
# Account SID + auth token. Trial account is free.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=

# ---------------------------------------------------------------------------
# Zendesk (zendesk) — signup, limited free tier
# Obtain: https://developer.zendesk.com/api-reference/introduction/security-and-auth/
# ZENDESK_EMAIL_TOKEN must be 'you@example.com/token'.
# ---------------------------------------------------------------------------
ZENDESK_EMAIL_TOKEN=
ZENDESK_API_TOKEN=
ZENDESK_SUBDOMAIN=
