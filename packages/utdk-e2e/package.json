{
  "name": "@utdk/e2e",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "End-to-end provider suite: generation integrity plus live direct/gateway/credential-store flows",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run tests/generation.test.ts",
    "test:generation": "vitest run tests/generation.test.ts",
    "test:live": "vitest run tests/live.test.ts",
    "test:all": "vitest run",
    "doctor": "tsx scripts/doctor.ts",
    "env:scaffold": "tsx scripts/write-env.ts"
  },
  "dependencies": {
    "@utdk/common": "workspace:*",
    "utdk": "workspace:*"
  },
  "devDependencies": {
    "@aprovan/vitest-config": "^0.1.0",
    "@types/node": "^25.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
