{
  "name": "@utdk/remote",
  "version": "0.1.4",
  "type": "module",
  "description": "Vendor-neutral UTDK remote client: namespace proxies, gateway transport, execution policy, pagination, and specifier parsing",
  "keywords": [
    "utdk",
    "remote",
    "proxy",
    "gateway",
    "transport"
  ],
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools-scan": {
      "types": "./dist/tools-scan.d.ts",
      "import": "./dist/tools-scan.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepare": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
